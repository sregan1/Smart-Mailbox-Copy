<UserControl x:Class="SmartMailboxCopy.App.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SmartMailboxCopy.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Border Style="{StaticResource StackCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource CardHeaderGlyph}"/>
                        <TextBlock Text="{loc:Loc Conn_RegLabel}" Style="{StaticResource CardHeader}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}" Text="{loc:Loc Conn_RegHint}"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button Content="{loc:Loc Conn_Manage}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Manage_Click"/>
                        <ComboBox x:Name="Combo" DisplayMemberPath="DisplayName" SelectionChanged="Combo_Changed" AutomationProperties.Name="{loc:Loc Conn_RegLabel}"/>
                    </DockPanel>
                    <TextBlock x:Name="Detail" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoBanner}" Padding="16,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Conn_PermsTitle}" Style="{StaticResource CardHeader}"/>
                    <TextBlock x:Name="PermissionsIntro" Style="{StaticResource Note}" Margin="0,3,0,8"/>
                    <TextBlock x:Name="PermissionsText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="TestButton" Content="{loc:Loc Conn_Connect}" Style="{StaticResource PrimaryBtn}" Click="Test_Click"/>
                <TextBlock x:Name="ResultText" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="460"/>
            </StackPanel>
            <TextBlock x:Name="CheckText" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Note}" FontSize="11" Margin="0,10,0,12" Text="{loc:Loc Conn_TestNote}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
