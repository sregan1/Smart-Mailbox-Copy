<Window x:Class="SmartMailboxCopy.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SmartMailboxCopy.App.Localization"
        Title="{loc:Loc Set_Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}" FlowDirection="{x:Static loc:Loc.FlowDirection}"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource WindowBgBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="{loc:Loc Set_Title}" Style="{StaticResource SectionHeader}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource StackCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE774;" Style="{StaticResource CardHeaderGlyph}"/>
                        <TextBlock Text="{loc:Loc Set_Language}" Style="{StaticResource CardHeader}"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" DisplayMemberPath="Text" AutomationProperties.Name="{loc:Loc Set_Language}"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="{loc:Loc Set_LanguageNote}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE790;" Style="{StaticResource CardHeaderGlyph}"/>
                        <TextBlock Text="{loc:Loc Set_Theme}" Style="{StaticResource CardHeader}"/>
                    </StackPanel>
                    <WrapPanel>
                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource FilterChip}" Content="{loc:Loc Set_ThemeSystem}"/>
                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource FilterChip}" Content="{loc:Loc Set_ThemeLight}"/>
                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource FilterChip}" Content="{loc:Loc Set_ThemeDark}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource FooterBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Btn_Cancel}" IsCancel="True" Margin="0,0,8,0" MinWidth="88"/>
                <Button Content="{loc:Loc Btn_Save}" Style="{StaticResource PrimaryBtn}" IsDefault="True" Click="Save_Click" MinWidth="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
