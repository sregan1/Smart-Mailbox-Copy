<Window x:Class="SmartMailboxCopy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartMailboxCopy.App"
        xmlns:loc="clr-namespace:SmartMailboxCopy.App.Localization"
        Title="{loc:Loc App_Name}" Width="1200" Height="820" MinWidth="1000" MinHeight="680"
        Background="{DynamicResource WindowBgBrush}"
        FlowDirection="{x:Static loc:Loc.FlowDirection}"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Closing="Window_Closing">

    <!-- Custom chrome: the blue app bar (row 0, 52 px) doubles as the title bar. Buttons inside it opt in with
         WindowChrome.IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One step in the step bar. The bubble is gray when upcoming, light accent with a check once done, accent when current, and
             green for the last step (Results) when it is current. DataContext is a NavItem. -->
        <Style x:Key="StepBubble" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Current}" Value="True"/>
                        <Condition Binding="{Binding IsLast}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepBubbleText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Mark}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,5,2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The connector on either side of a bubble: accent where the way is already walked -->
        <Style x:Key="StepLineLeft" TargetType="Rectangle">
            <Setter Property="Height" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource BorderLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepLineRight" TargetType="Rectangle">
            <Setter Property="Height" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource BorderLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A finished step can be clicked to go back to it; the current and upcoming ones cannot -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource RowHeaderBtn}">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <!-- No horizontal padding, so the connector lines of neighboring steps meet -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="0,3">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="Focusable" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Window caption buttons -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E81123"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A card header: a blue glyph and a title -->
        <DataTemplate x:Key="StatTile">
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,10" MinWidth="150">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBgBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- A maximized borderless window overhangs the screen by the resize border: pad the content back into view -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= app bar ================= -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="6" Background="White" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="&#xE715;" Style="{StaticResource GlyphIcon}" FontSize="20" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Loc App_Name}" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource AppBarBtn}" Margin="0,0,8,0" Click="ManageRegs_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Bar_Registrations}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AppBarBtn}" Margin="0,0,8,0" Click="OpenReports_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Bar_Reports}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AppBarBtn}" Click="Settings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Bar_Settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtn}" Click="Minimize_Click" AutomationProperties.Name="{loc:Loc Auto_Minimize}">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource GlyphFont}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="MaximizeRestore_Click" AutomationProperties.Name="{loc:Loc Auto_Maximize}">
                        <TextBlock FontFamily="{StaticResource GlyphFont}" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtn}" Click="CloseWindow_Click" AutomationProperties.Name="{loc:Loc Auto_Close}">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource GlyphFont}" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= step bar ================= -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="24,12,24,10">
            <ItemsControl x:Name="StepBar" AutomationProperties.Name="{loc:Loc Auto_Steps}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource StepButton}" Click="Step_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Grid.Column="0" Style="{StaticResource StepLineLeft}"/>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StepBubble}" Margin="4,0">
                                    <TextBlock Style="{StaticResource StepBubbleText}"/>
                                </Border>
                                <Rectangle Grid.Row="0" Grid.Column="2" Style="{StaticResource StepLineRight}"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Label}" Style="{StaticResource StepLabel}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ================= step content ================= -->
        <Grid Grid.Row="2" Margin="32,22,32,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="StepTitle" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="StepDesc" Style="{StaticResource SubHeader}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- 0 Welcome -->
                <ScrollViewer x:Name="Step0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14" Text="{loc:Loc Welcome_Intro}"/>
                        <Border Style="{StaticResource StackCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource CardHeaderGlyph}"/>
                                    <TextBlock Text="{loc:Loc Welcome_WillTitle}" Style="{StaticResource CardHeader}"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Text="{loc:Loc Welcome_WillBody}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StackCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource CardHeaderGlyph}"/>
                                    <TextBlock Text="{loc:Loc Welcome_NeedTitle}" Style="{StaticResource CardHeader}"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Text="{loc:Loc Welcome_NeedBody}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StackCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource CardHeaderGlyph}"/>
                                    <TextBlock Text="{loc:Loc Welcome_HowTitle}" Style="{StaticResource CardHeader}"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Text="{loc:Loc Welcome_HowBody}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoBanner}" Padding="14,10" Margin="0,4,0,0">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Welcome_NextHint}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1 Source, 2 Target -->
                <local:ConnectionPanel x:Name="SourcePanel"/>
                <local:ConnectionPanel x:Name="TargetPanel"/>

                <!-- 3 Choose mailboxes -->
                <Grid x:Name="Step3">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10" Text="{loc:Loc Boxes_Intro}"/>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,10">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="KindUsers" Content="{loc:Loc Boxes_Users}" IsChecked="True" Margin="0,3,18,3" Click="Filter_Changed"/>
                                <CheckBox x:Name="KindResources" Content="{loc:Loc Boxes_Resources}" Margin="0,3,18,3" Click="Filter_Changed"/>
                                <CheckBox x:Name="KindGuests" Content="{loc:Loc Boxes_Guests}" Margin="0,3,18,3" Click="Filter_Changed"/>
                                <CheckBox x:Name="EnabledOnly" Content="{loc:Loc Boxes_EnabledOnly}" Margin="0,3,18,3" Click="Filter_Changed"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="{loc:Loc Boxes_Domain}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="DomainFilter" Width="200" Margin="0,0,18,0" SelectionChanged="Filter_Changed" AutomationProperties.Name="{loc:Loc Boxes_AutoDomain}"/>
                                <TextBlock Text="{loc:Loc Boxes_Search}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SearchBox" Width="240" FlowDirection="LeftToRight" TextChanged="Search_Changed" AutomationProperties.Name="{loc:Loc Boxes_AutoSearch}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="MailboxGrid" Grid.Row="2" SelectionMode="Extended" AutomationProperties.Name="{loc:Loc Boxes_AutoGrid}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{loc:Loc Boxes_ColCopy}" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                    ElementStyle="{StaticResource GridCheck}" EditingElementStyle="{StaticResource GridCheck}"/>
                            <DataGridTextColumn Header="{loc:Loc Boxes_ColName}" Binding="{Binding Name}" IsReadOnly="True" Width="200"/>
                            <DataGridTextColumn Header="{loc:Loc Boxes_ColAddress}" Binding="{Binding Upn}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Boxes_ColType}" Binding="{Binding KindText}" IsReadOnly="True" Width="250"/>
                            <DataGridTextColumn Header="{loc:Loc Boxes_ColAccount}" Binding="{Binding EnabledText}" IsReadOnly="True" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Loc Boxes_TickAll}" Click="SelectShown_Click" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Boxes_UntickAll}" Click="UnselectShown_Click" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Boxes_Refresh}" Click="RefreshSource_Click" Margin="0,0,16,0"/>
                        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- 4 Match -->
                <Grid x:Name="Step4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10" Text="{loc:Loc Match_Intro}"/>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc Match_TargetDomain}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TargetDomain" IsEditable="True" Width="240" Margin="0,0,10,0" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Loc Match_AutoDomain}"/>
                        <Button Content="{loc:Loc Match_ApplyDomain}" Click="ApplyDomain_Click" Margin="0,0,16,0"/>
                        <Button Content="{loc:Loc Match_Import}" Click="ImportMap_Click" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Match_Export}" Click="ExportMap_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="MapGrid" Grid.Row="2" AutomationProperties.Name="{loc:Loc Match_AutoGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Match_ColSource}" Binding="{Binding Source}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Match_ColTarget}" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTemplateColumn Header="{loc:Loc Match_ColStatus}" Width="260" SortMemberPath="Status" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusChip}">
                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="MapSummary" Grid.Row="3" Margin="0,10,0,0" FontWeight="SemiBold"/>
                </Grid>

                <!-- 5 Options -->
                <ScrollViewer x:Name="Step5" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">

                        <Border Style="{StaticResource StackCard}">
                            <StackPanel>
                                <CheckBox x:Name="PimOnly" FontWeight="SemiBold" Click="Mode_Changed" Content="{loc:Loc Opt_PimOnly}"/>
                                <TextBlock Style="{StaticResource Note}" Margin="26,0,0,0" Text="{loc:Loc Opt_PimOnlyNote}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="MailSection">
                            <TextBlock Style="{StaticResource Heading}" Text="{loc:Loc Opt_WhereTitle}" Margin="0,6,0,8"/>
                            <Border Style="{StaticResource StackCard}">
                                <StackPanel>
                                    <RadioButton x:Name="ModeContainer" GroupName="MailMode" IsChecked="True" Checked="Mode_Changed" FontWeight="SemiBold" Content="{loc:Loc Opt_Container}"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="26,0,0,8" Text="{loc:Loc Opt_ContainerNote}"/>
                                    <DockPanel Margin="26,0,0,0">
                                        <TextBlock Text="{loc:Loc Opt_FolderName}" DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="ContainerName" TextChanged="Option_Changed" AutomationProperties.Name="{loc:Loc Opt_AutoFolderName}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StackCard}">
                                <StackPanel>
                                    <RadioButton x:Name="ModeMerge" GroupName="MailMode" Checked="Mode_Changed" FontWeight="SemiBold" Content="{loc:Loc Opt_Merge}"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="26,0,0,8" Text="{loc:Loc Opt_MergeNote}"/>
                                    <CheckBox x:Name="IncludePim" IsChecked="True" Margin="26,3,0,0" Click="Option_Changed" IsEnabled="False" Content="{loc:Loc Opt_IncludePim}"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="52,0,0,0" Text="{loc:Loc Opt_IncludePimNote}"/>
                                </StackPanel>
                            </Border>

                            <Expander x:Name="FilterExpander" Style="{StaticResource OptionsExpander}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Text="{loc:Loc Opt_LimitIntro}"/>
                                    <TextBlock Text="{loc:Loc Opt_LeaveOutFolders}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="FolderInbox" Content="{loc:Loc Folder_Inbox}" Margin="0,3,18,3" Click="Option_Changed"/>
                                        <CheckBox x:Name="FolderSent" Content="{loc:Loc Folder_Sent}" Margin="0,3,18,3" Click="Option_Changed"/>
                                        <CheckBox x:Name="FolderDrafts" Content="{loc:Loc Folder_Drafts}" Margin="0,3,18,3" Click="Option_Changed"/>
                                        <CheckBox x:Name="FolderDeleted" Content="{loc:Loc Folder_Deleted}" Margin="0,3,18,3" Click="Option_Changed"/>
                                        <CheckBox x:Name="FolderJunk" Content="{loc:Loc Folder_Junk}" Margin="0,3,18,3" Click="Option_Changed"/>
                                        <CheckBox x:Name="FolderArchive" Content="{loc:Loc Folder_Archive}" Margin="0,3,18,3" Click="Option_Changed"/>
                                        <CheckBox x:Name="FolderUser" Content="{loc:Loc Folder_User}" Margin="0,3,18,3" Click="Option_Changed"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Note}" Text="{loc:Loc Opt_LeaveOutNote}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <CheckBox x:Name="DateFilter" Content="{loc:Loc Opt_DateFilter}" VerticalAlignment="Center" Click="Option_Changed"/>
                                        <DatePicker x:Name="SinceDate" Margin="12,0,0,0" Width="160" IsEnabled="False" SelectedDateChanged="DateChanged" AutomationProperties.Name="{loc:Loc Opt_AutoEarliest}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="26,0,0,0" Text="{loc:Loc Opt_DateNote}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <CheckBox x:Name="SizeFilter" Content="{loc:Loc Opt_SizeFilter}" VerticalAlignment="Center" Click="Option_Changed"/>
                                        <TextBox x:Name="MaxMb" Text="25" Width="64" Margin="12,0,6,0" IsEnabled="False" FlowDirection="LeftToRight" TextChanged="Option_Changed" AutomationProperties.Name="{loc:Loc Opt_AutoMaxMb}"/>
                                        <TextBlock Text="{loc:Loc Opt_MB}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Border Style="{StaticResource StackCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource CardHeaderGlyph}"/>
                                    <TextBlock Text="{loc:Loc Opt_SafetyTitle}" Style="{StaticResource CardHeader}"/>
                                </StackPanel>
                                <CheckBox x:Name="Dedupe" IsChecked="True" Content="{loc:Loc Opt_Dedupe}"/>
                                <CheckBox x:Name="Verify" IsChecked="True" Content="{loc:Loc Opt_Verify}"/>
                                <CheckBox x:Name="AllowNonEmpty" IsEnabled="False" Content="{loc:Loc Opt_AllowNonEmpty}"/>
                                <TextBlock Style="{StaticResource Note}" Margin="26,0,0,0" Text="{loc:Loc Opt_AllowNonEmptyNote}"/>
                            </StackPanel>
                        </Border>

                        <Expander Header="{loc:Loc Opt_Advanced}" Style="{StaticResource OptionsExpander}" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="Fresh" Content="{loc:Loc Opt_Fresh}"/>
                                <TextBlock Style="{StaticResource Heading}" Text="{loc:Loc Opt_LeaveOutCalTitle}"/>
                                <TextBlock Style="{StaticResource Note}" Text="{loc:Loc Opt_LeaveOutCalNote}"/>
                                <TextBox x:Name="LeaveOutCal" AcceptsReturn="True" Height="64" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" AutomationProperties.Name="{loc:Loc Opt_LeaveOutCalTitle}"/>
                                <TextBlock Style="{StaticResource Heading}" Text="{loc:Loc Opt_ProtectedTitle}"/>
                                <TextBlock Style="{StaticResource Note}" Text="{loc:Loc Opt_ProtectedNote}"/>
                                <TextBox x:Name="Protected" AcceptsReturn="True" Height="74" FlowDirection="LeftToRight" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" AutomationProperties.Name="{loc:Loc Opt_ProtectedTitle}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6 Review -->
                <ScrollViewer x:Name="Step6" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <Border Style="{StaticResource StackCard}" Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource AccentBrush}">
                            <TextBlock x:Name="PlanText" TextWrapping="Wrap" LineHeight="22"/>
                        </Border>
                        <Border Style="{StaticResource StackCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" Style="{StaticResource CardHeaderGlyph}"/>
                                    <TextBlock Text="{loc:Loc Rev_EstimateTitle}" Style="{StaticResource CardHeader}"/>
                                </StackPanel>
                                <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <ProgressBar x:Name="EstimateBar" Minimum="0" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed"/>
                                <Button x:Name="SkipEstimateButton" Content="{loc:Loc Rev_SkipEstimate}" Click="SkipEstimate_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="WarnCard" Style="{StaticResource WarningBanner}" Padding="16,12" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="WarnText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <CheckBox x:Name="Understand" Visibility="Collapsed" Margin="0,6,0,0" Click="Option_Changed" TextBlock.FontWeight="SemiBold" Content="{loc:Loc Rev_Understand}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 8 Results -->
                <ScrollViewer x:Name="Step8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <Border x:Name="ResultBanner" Padding="18,14" Margin="0,0,0,14" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <TextBlock x:Name="ResultTitle" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ResultSub" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="StatsList" ItemTemplate="{StaticResource StatTile}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Heading}" Text="{loc:Loc Res_ByMailbox}"/>
                        <DataGrid x:Name="ResultGrid" MaxHeight="380" IsReadOnly="True" RowStyle="{StaticResource ProblemRow}" AutomationProperties.Name="{loc:Loc Res_AutoGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Col_Source}" Binding="{Binding Source}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Target}" Binding="{Binding Target}" Width="Auto"/>
                                <DataGridTemplateColumn Header="{loc:Loc Col_Result}" Width="Auto" SortMemberPath="Result">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusChip}">
                                                <TextBlock Text="{Binding Result}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Col_Copied}" Binding="{Binding Copied}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Already}" Binding="{Binding AlreadyThere}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Failed}" Binding="{Binding Failed}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:Loc Col_Verified}" Binding="{Binding Verified}" Width="Auto"/>
                                <DataGridTemplateColumn Header="{loc:Loc Col_Notes}" Width="2*" ClipboardContentBinding="{Binding Notes}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Notes, Mode=OneWay}" AutomationProperties.Name="{loc:Loc Col_AutoNotes}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Heading}" Text="{loc:Loc Res_NextTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <TextBlock x:Name="NextSteps" TextWrapping="Wrap" LineHeight="22"/>
                        </Border>
                        <Button Content="{loc:Loc Res_CopySummary}" Click="CopySummary_Click" HorizontalAlignment="Left" Margin="0,14,0,8"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 7 Copy -->
                <Grid x:Name="Step7">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="RunHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="MailboxBar" Height="10" Margin="0,10,0,6" Minimum="0" Maximum="1000" AutomationProperties.Name="{loc:Loc Run_AutoProgress}"/>
                            <TextBlock x:Name="EtaText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PhaseText" Style="{StaticResource Note}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{loc:Loc Run_Mailboxes}" Style="{StaticResource Heading}" Margin="0,12,0,6"/>
                    <DataGrid x:Name="RunGrid" Grid.Row="2" IsReadOnly="True" RowStyle="{StaticResource ProblemRow}" AutomationProperties.Name="{loc:Loc Run_AutoGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Col_Index}" Binding="{Binding Index}" Width="46"/>
                            <DataGridTextColumn Header="{loc:Loc Col_Source}" Binding="{Binding Source}" Width="Auto"/>
                            <DataGridTextColumn Header="{loc:Loc Col_Target}" Binding="{Binding Target}" Width="Auto"/>
                            <DataGridTemplateColumn Header="{loc:Loc Col_Status}" Width="140" SortMemberPath="StateText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusChip}">
                                            <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Loc Col_Details}" Width="2*" ClipboardContentBinding="{Binding Message}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Message, Mode=OneWay}" AutomationProperties.Name="{loc:Loc Col_AutoDetails}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Expander x:Name="FolderExpander" Grid.Row="3" Header="{loc:Loc Run_FolderDetail}" Style="{StaticResource OptionsExpander}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TotalsText" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <DataGrid x:Name="FolderGrid" Height="170" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Col_Folder}" Binding="{Binding Display}" Width="200"/>
                                    <DataGridTextColumn Header="{loc:Loc Col_Kind}" Binding="{Binding Kind}" Width="130"/>
                                    <DataGridTextColumn Header="{loc:Loc Col_Items}" Binding="{Binding Items}" Width="70"/>
                                    <DataGridTextColumn Header="{loc:Loc Col_Copied}" Binding="{Binding Imported}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc Col_Already}" Binding="{Binding AlreadyDone}" Width="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Col_Failed}" Binding="{Binding Failed}" Width="70"/>
                                    <DataGridTemplateColumn Header="{loc:Loc Col_Status}" Width="*" SortMemberPath="Status">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusChip}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="LogExpander" Grid.Row="4" Header="{loc:Loc Run_Log}" Style="{StaticResource OptionsExpander}" Margin="0,8,0,0">
                        <DockPanel Height="170">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox x:Name="OnlyProblems" Content="{loc:Loc Run_OnlyProblems}" Margin="0,0,16,0" VerticalAlignment="Center" Click="LogFilter_Click"/>
                                <TextBlock x:Name="CountsText" Style="{StaticResource Note}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Expander>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= footer ================= -->
        <Border Grid.Row="3" Background="{DynamicResource FooterBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="32,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="NavHint" VerticalAlignment="Center" Style="{StaticResource Note}" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenResultsButton" Content="{loc:Loc Btn_OpenResults}" Click="OpenResults_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="OpenItemsButton" Content="{loc:Loc Btn_OpenItems}" Click="OpenItems_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="OpenLogButton" Content="{loc:Loc Btn_OpenLog}" Click="OpenLog_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="RunAgainButton" Content="{loc:Loc Btn_RunAgain}" Click="RunAgain_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="StopButton" Content="{loc:Loc Btn_Stop}" Style="{StaticResource DangerBtn}" Click="Stop_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="BackButton" Content="{loc:Loc Btn_Back}" Click="Back_Click" Margin="0,0,8,0" MinWidth="88"/>
                    <Button x:Name="NextButton" Content="{loc:Loc Btn_Next}" Style="{StaticResource PrimaryBtn}" Click="Next_Click" IsDefault="True" FontWeight="SemiBold" MinWidth="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
