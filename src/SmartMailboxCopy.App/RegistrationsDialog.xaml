<Window x:Class="SmartMailboxCopy.App.RegistrationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SmartMailboxCopy.App.Localization"
        Title="{loc:Loc Reg_Title}" Width="820" Height="640" MinWidth="720" MinHeight="560"
        Background="{DynamicResource WindowBgBrush}" FlowDirection="{x:Static loc:Loc.FlowDirection}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Background="{DynamicResource WindowBgBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Padding="24,18,24,14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{loc:Loc Reg_Title}" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Reg_Intro}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{loc:Loc Reg_Add}" Click="Add_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RemoveButton" Content="{loc:Loc Reg_Remove}" Click="Remove_Click" IsEnabled="False"/>
                </StackPanel>
                <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" DisplayMemberPath="DisplayName"/>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Form" IsEnabled="False" Margin="0,0,10,0">
                        <TextBlock Text="{loc:Loc Reg_Name}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource Note}" FontSize="11" Text="{loc:Loc Reg_NameHint}"/>
                        <TextBox x:Name="NameBox" Margin="0,4,0,12" TextChanged="Field_Changed"/>

                        <TextBlock Text="{loc:Loc Reg_Tenant}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource Note}" FontSize="11" Text="{loc:Loc Reg_TenantHint}"/>
                        <TextBox x:Name="TenantBox" Margin="0,4,0,12" FlowDirection="LeftToRight" TextChanged="Field_Changed"/>

                        <TextBlock Text="{loc:Loc Reg_Client}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource Note}" FontSize="11" Text="{loc:Loc Reg_ClientHint}"/>
                        <TextBox x:Name="ClientBox" Margin="0,4,0,12" FlowDirection="LeftToRight" TextChanged="Field_Changed"/>

                        <TextBlock Text="{loc:Loc Reg_Secret}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource Note}" FontSize="11" Text="{loc:Loc Reg_SecretHint}"/>
                        <PasswordBox x:Name="SecretBox" Margin="0,4,0,4" FlowDirection="LeftToRight" PasswordChanged="Secret_Changed"/>
                        <StackPanel x:Name="SecretSaved" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Reg_SecretSaved}" Style="{StaticResource Note}" FontSize="11" VerticalAlignment="Center"/>
                            <Button Content="{loc:Loc Reg_Clear}" Style="{StaticResource LinkBtn}" Click="ClearSecret_Click" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource InfoBanner}" Padding="12,10" Margin="0,16,0,4">
                            <TextBlock TextWrapping="Wrap" FontSize="12" x:Name="SetupHelp"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource FooterBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Btn_Cancel}" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="88"/>
                <Button Content="{loc:Loc Btn_Save}" Style="{StaticResource PrimaryBtn}" IsDefault="True" Click="Save_Click" MinWidth="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
