<Window x:Class="SmartMailboxCopy.App.RegistrationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App registrations" Width="780" Height="600" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Border Padding="20">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="App registrations" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="Gray" FontSize="12"
                       Text="An app registration is the identity this tool uses to talk to Microsoft 365 in a tenant. You create it once per tenant in the Microsoft Entra admin center, then save it here under a name you recognize and pick it on the Source and Target steps. Nothing here is sent anywhere; it is stored for your Windows user only."/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add" Click="Add_Click" Padding="12,4" Margin="0,0,8,0"/>
                    <Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click" Padding="12,4" IsEnabled="False"/>
                </StackPanel>
                <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" DisplayMemberPath="DisplayName"/>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Form" IsEnabled="False">
                    <TextBlock Text="Name" FontWeight="SemiBold"/>
                    <TextBlock Foreground="Gray" FontSize="11" Text="Anything that helps you tell them apart, for example &quot;Contoso (source)&quot;."/>
                    <TextBox x:Name="NameBox" Margin="0,2,0,10" Padding="3" TextChanged="Field_Changed"/>

                    <TextBlock Text="Directory (tenant) ID" FontWeight="SemiBold"/>
                    <TextBlock Foreground="Gray" FontSize="11" Text="A GUID. On the registration's Overview page in the Entra admin center."/>
                    <TextBox x:Name="TenantBox" Margin="0,2,0,10" Padding="3" TextChanged="Field_Changed"/>

                    <TextBlock Text="Application (client) ID" FontWeight="SemiBold"/>
                    <TextBlock Foreground="Gray" FontSize="11" Text="A GUID. Also on the Overview page."/>
                    <TextBox x:Name="ClientBox" Margin="0,2,0,10" Padding="3" TextChanged="Field_Changed"/>

                    <TextBlock Text="Client secret" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Text="The secret's Value (not its ID), from Certificates &amp; secrets. It lets the app copy mailboxes without anyone signing in. It is encrypted for your Windows user and cannot be read on another PC. It is shown only as it is typed; type a new one to replace it."/>
                    <PasswordBox x:Name="SecretBox" Margin="0,2,0,2" Padding="3" PasswordChanged="Secret_Changed"/>
                    <StackPanel x:Name="SecretSaved" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="A secret is saved." Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="Clear" Click="ClearSecret_Click" Margin="8,0,0,0" Padding="8,1"/>
                    </StackPanel>

                    <Border Background="#EEF4FB" BorderBrush="#B7CDE6" BorderThickness="1" Padding="10" Margin="0,16,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="11" x:Name="SetupHelp"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="14,5" Margin="0,0,10,0"/>
            <Button Content="Save" IsDefault="True" Click="Save_Click" Padding="14,5" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
